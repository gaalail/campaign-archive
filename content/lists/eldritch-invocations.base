filters:
  and:
    - file.inFolder("character-options/class-options/eldritch-invocations")
    - file.name != "index"
formulas:
  Name: file.asLink(title)
properties:
  formula.Name:
    displayName: Name
  min_level:
    displayName: Level
  prerequisite:
    displayName: Prerequisite
  summary:
    displayName: Summary
  source:
    displayName: Source
views:
  - type: table
    name: By level
    groupBy:
      property: min_level
      direction: ASC
    order: [formula.Name, prerequisite, summary]
    sort:
      - property: min_level
        direction: ASC
      - property: file.name
        direction: ASC
