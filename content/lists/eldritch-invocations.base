filters:
  and:
    - file.inFolder("character-options/class-options/eldritch-invocations")
    - file.name != "index"
formulas:
  Name: file.asLink(title)
properties:
  formula.Name:
    displayName: Invocation
  min_level:
    displayName: Min Level
  prerequisite:
    displayName: Prerequisite
  summary:
    displayName: Summary
  source:
    displayName: Source
views:
  - type: table
    name: Eldritch Invocations
    order: [formula.Name, min_level, prerequisite, summary, source]
    sort:
      - property: min_level
        direction: ASC
      - property: file.name
        direction: ASC
