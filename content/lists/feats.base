filters:
  and:
    - file.inFolder("character-options/feats")
    - file.name != "index"
formulas:
  Name: file.asLink(title)
properties:
  formula.Name:
    displayName: Feat
  prerequisite:
    displayName: Prerequisite
  summary:
    displayName: Summary
  source:
    displayName: Source
views:
  - type: table
    name: All Feats
    order: [formula.Name, prerequisite, summary, source]
    sort:
      - property: file.name
        direction: ASC
