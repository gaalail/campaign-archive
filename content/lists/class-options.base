filters:
  and:
    - file.inFolder("character-options/class-options")
    - file.name != "index"
formulas:
  Name: file.asLink(title)
properties:
  formula.Name:
    displayName: Option
  parent_class:
    displayName: Class
  option_group:
    displayName: Group
  min_level:
    displayName: Min Level
  prerequisite:
    displayName: Prerequisite
  source:
    displayName: Source
views:
  - type: table
    name: All Class Options
    order: [formula.Name, parent_class, option_group, min_level, prerequisite, source]
    sort:
      - property: file.name
        direction: ASC
