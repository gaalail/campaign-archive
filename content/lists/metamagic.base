filters:
  and:
    - file.inFolder("character-options/class-options/metamagic")
    - file.name != "index"
formulas:
  Name: file.asLink(title)
properties:
  formula.Name:
    displayName: Option
  cost:
    displayName: Sorcery Points
  summary:
    displayName: Summary
  source:
    displayName: Source
views:
  - type: table
    name: Metamagic
    order: [formula.Name, cost, summary, source]
    sort:
      - property: file.name
        direction: ASC
