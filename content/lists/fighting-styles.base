filters:
  and:
    - file.inFolder("character-options/fighting-styles")
    - file.name != "index"
formulas:
  Name: file.asLink(title)
properties:
  formula.Name:
    displayName: Fighting Style
  summary:
    displayName: Summary
  source:
    displayName: Source
views:
  - type: table
    name: All Fighting Styles
    order: [formula.Name, summary, source]
    sort:
      - property: file.name
        direction: ASC
