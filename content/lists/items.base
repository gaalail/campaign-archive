filters:
  and:
    - file.inFolder("items")
    - file.name != "index"
formulas:
  Name: file.asLink(title)
properties:
  formula.Name:
    displayName: Name
  rarity:
    displayName: Rarity
  item_type:
    displayName: Item type
  attunement:
    displayName: Attunement
  summary:
    displayName: Summary
  source:
    displayName: Source
views:
  - type: table
    name: All items
    order: [formula.Name, rarity, item_type, attunement]
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Common
    filters:
      and:
        - rarity == "Common"
    order: [formula.Name, item_type, attunement]
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Uncommon
    filters:
      and:
        - rarity == "Uncommon"
    order: [formula.Name, item_type, attunement]
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Rare
    filters:
      and:
        - rarity == "Rare"
    order: [formula.Name, item_type, attunement]
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Very Rare
    filters:
      and:
        - rarity == "Very Rare"
    order: [formula.Name, item_type, attunement]
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Legendary
    filters:
      and:
        - rarity == "Legendary"
    order: [formula.Name, item_type, attunement]
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Artifact
    filters:
      and:
        - rarity == "Artifact"
    order: [formula.Name, item_type, attunement]
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Varies
    filters:
      and:
        - rarity == "Varies"
    order: [formula.Name, item_type, attunement]
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Homebrew
    filters:
      and:
        - source == "Homebrew"
    order: [formula.Name, rarity, item_type]
    sort:
      - property: file.name
        direction: ASC
