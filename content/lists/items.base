filters:
  and:
    - file.inFolder("items")
    - file.name != "index"
formulas:
  Name: file.asLink(title)
properties:
  formula.Name:
    displayName: Name
  rarity:
    displayName: Rarity
  item_type:
    displayName: Type
  attunement:
    displayName: Attunement
  source:
    displayName: Source
views:
  - type: table
    name: All Items
    order: [formula.Name, item_type, rarity, attunement, source]
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Weapon
    filters:
      and:
        - item_type == "Weapon"
    order: [formula.Name, rarity, attunement, source]
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Armor
    filters:
      and:
        - item_type == "Armor"
    order: [formula.Name, rarity, attunement, source]
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Potion
    filters:
      and:
        - item_type == "Potion"
    order: [formula.Name, rarity, source]
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Ring
    filters:
      and:
        - item_type == "Ring"
    order: [formula.Name, rarity, attunement, source]
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Rod
    filters:
      and:
        - item_type == "Rod"
    order: [formula.Name, rarity, attunement, source]
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Scroll
    filters:
      and:
        - item_type == "Scroll"
    order: [formula.Name, rarity, source]
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Staff
    filters:
      and:
        - item_type == "Staff"
    order: [formula.Name, rarity, attunement, source]
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Wand
    filters:
      and:
        - item_type == "Wand"
    order: [formula.Name, rarity, attunement, source]
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Wondrous Items
    filters:
      and:
        - item_type == "Wondrous Item"
    order: [formula.Name, rarity, attunement, source]
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Ammunition
    filters:
      and:
        - item_type == "Ammunition"
    order: [formula.Name, rarity, source]
    sort:
      - property: file.name
        direction: ASC
