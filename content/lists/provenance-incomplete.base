filters:
  and:
    - file.name != "index"
    - content_status == "incomplete"
formulas:
  Name: file.asLink(title)
properties:
  formula.Name:
    displayName: Name
  entity_type:
    displayName: Type
  source_type:
    displayName: Source type
  incomplete_reason:
    displayName: Review reason
views:
  - type: table
    name: Incomplete Content
    order: [formula.Name, entity_type, source_type, incomplete_reason]
    sort:
      - property: file.name
        direction: ASC
