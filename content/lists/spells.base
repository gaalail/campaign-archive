filters:
  and:
    - file.inFolder("spells")
    - file.name != "index"
formulas:
  Name: file.asLink(title)
properties:
  formula.Name:
    displayName: Name
  level:
    displayName: Level
  school:
    displayName: School
  classes:
    displayName: Classes
  casting_time:
    displayName: Casting time
  range:
    displayName: Range
  duration:
    displayName: Duration
  components:
    displayName: Components
  source:
    displayName: Source
views:
  - type: table
    name: All by level
    groupBy:
      property: level
      direction: ASC
    order: [formula.Name, school, casting_time, range, duration, components]
    sort:
      - property: level
        direction: ASC
      - property: file.name
        direction: ASC
  - type: table
    name: Bard
    groupBy:
      property: level
      direction: ASC
    filters:
      and:
        - classes.contains("Bard")
    order: [formula.Name, school, casting_time, range, duration, components]
    sort:
      - property: level
        direction: ASC
      - property: file.name
        direction: ASC
  - type: table
    name: Cleric
    groupBy:
      property: level
      direction: ASC
    filters:
      and:
        - classes.contains("Cleric")
    order: [formula.Name, school, casting_time, range, duration, components]
    sort:
      - property: level
        direction: ASC
      - property: file.name
        direction: ASC
  - type: table
    name: Druid
    groupBy:
      property: level
      direction: ASC
    filters:
      and:
        - classes.contains("Druid")
    order: [formula.Name, school, casting_time, range, duration, components]
    sort:
      - property: level
        direction: ASC
      - property: file.name
        direction: ASC
  - type: table
    name: Paladin
    groupBy:
      property: level
      direction: ASC
    filters:
      and:
        - classes.contains("Paladin")
    order: [formula.Name, school, casting_time, range, duration, components]
    sort:
      - property: level
        direction: ASC
      - property: file.name
        direction: ASC
  - type: table
    name: Ranger
    groupBy:
      property: level
      direction: ASC
    filters:
      and:
        - classes.contains("Ranger")
    order: [formula.Name, school, casting_time, range, duration, components]
    sort:
      - property: level
        direction: ASC
      - property: file.name
        direction: ASC
  - type: table
    name: Sorcerer
    groupBy:
      property: level
      direction: ASC
    filters:
      and:
        - classes.contains("Sorcerer")
    order: [formula.Name, school, casting_time, range, duration, components]
    sort:
      - property: level
        direction: ASC
      - property: file.name
        direction: ASC
  - type: table
    name: Warlock
    groupBy:
      property: level
      direction: ASC
    filters:
      and:
        - classes.contains("Warlock")
    order: [formula.Name, school, casting_time, range, duration, components]
    sort:
      - property: level
        direction: ASC
      - property: file.name
        direction: ASC
  - type: table
    name: Wizard
    groupBy:
      property: level
      direction: ASC
    filters:
      and:
        - classes.contains("Wizard")
    order: [formula.Name, school, casting_time, range, duration, components]
    sort:
      - property: level
        direction: ASC
      - property: file.name
        direction: ASC
  - type: table
    name: Search and sort
    order: [formula.Name, level, school, classes, casting_time, range, duration]
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Homebrew
    filters:
      and:
        - source != "SRD 5.1"
    order: [formula.Name, level, school, classes]
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Cantrips
    filters:
      and:
        - level == 0
    order: [formula.Name, school, classes, casting_time, range, duration, components]
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: 1st-Level
    filters:
      and:
        - level == 1
    order: [formula.Name, school, classes, casting_time, range, duration, components]
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: 2nd-Level
    filters:
      and:
        - level == 2
    order: [formula.Name, school, classes, casting_time, range, duration, components]
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: 3rd-Level
    filters:
      and:
        - level == 3
    order: [formula.Name, school, classes, casting_time, range, duration, components]
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: 4th-Level
    filters:
      and:
        - level == 4
    order: [formula.Name, school, classes, casting_time, range, duration, components]
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: 5th-Level
    filters:
      and:
        - level == 5
    order: [formula.Name, school, classes, casting_time, range, duration, components]
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: 6th-Level
    filters:
      and:
        - level == 6
    order: [formula.Name, school, classes, casting_time, range, duration, components]
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: 7th-Level
    filters:
      and:
        - level == 7
    order: [formula.Name, school, classes, casting_time, range, duration, components]
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: 8th-Level
    filters:
      and:
        - level == 8
    order: [formula.Name, school, classes, casting_time, range, duration, components]
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: 9th-Level
    filters:
      and:
        - level == 9
    order: [formula.Name, school, classes, casting_time, range, duration, components]
    sort:
      - property: file.name
        direction: ASC
