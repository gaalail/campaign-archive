filters:
  and:
    - file.inFolder("character-options/class-options/monk-techniques")
    - file.name != "index"
formulas:
  Name: file.asLink(title)
properties:
  formula.Name:
    displayName: Technique
  min_level:
    displayName: Min Level
  prerequisite:
    displayName: Prerequisite
  summary:
    displayName: Summary
  source:
    displayName: Source
views:
  - type: table
    name: Monk Techniques
    order: [formula.Name, min_level, prerequisite, summary, source]
    sort:
      - property: file.name
        direction: ASC
