filters:
  and:
    - file.inFolder("character-options/class-options/monk-technique-options/core")
formulas:
  Name: file.asLink(title)
properties:
  formula.Name:
    displayName: Technique
  prerequisite:
    displayName: Prerequisite
  summary:
    displayName: Summary
  source:
    displayName: Source
views:
  - type: table
    name: Core Mystic Techniques
    order: [formula.Name, prerequisite, summary]
    sort:
      - property: file.name
        direction: ASC
