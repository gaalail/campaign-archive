filters:
  and:
    - file.inFolder("character-options/class-options/familiars")
    - file.name != "index"
    - parent_class == "Warlock"
    - option_group == "Eldritch Familiar"
formulas:
  Name: file.asLink(title)
properties:
  formula.Name:
    displayName: Familiar
  summary:
    displayName: Summary
views:
  - type: table
    name: Eldritch Familiars
    order: [formula.Name, summary]
    sort:
      - property: file.name
        direction: ASC
