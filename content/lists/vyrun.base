filters:
  and:
    - file.inFolder("campaigns/vyrun")
    - file.name != "index"
formulas:
  Name: file.asLink(title)
properties:
  formula.Name:
    displayName: Name
  type:
    displayName: Type
  summary:
    displayName: Summary
  tags:
    displayName: Tags
views:
  - type: table
    name: All entries
    order: [formula.Name, type, summary]
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Characters
    filters:
      and:
        - type == "Character"
    order: [formula.Name, summary]
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Locations
    filters:
      and:
        - type == "Place"
    order: [formula.Name, summary]
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Sessions
    filters:
      and:
        - type == "Session"
    order: [formula.Name, summary]
    sort:
      - property: file.name
        direction: ASC
