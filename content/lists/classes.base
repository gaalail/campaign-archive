filters:
  and:
    - file.inFolder("character-options/classes")
    - file.name != "index"
formulas:
  Name: file.asLink(title)
properties:
  formula.Name:
    displayName: Class
  hit_die:
    displayName: Hit Die
  summary:
    displayName: Summary
  source:
    displayName: Source
views:
  - type: table
    name: All Classes
    order: [formula.Name, hit_die, summary, source]
    sort:
      - property: file.name
        direction: ASC
