filters:
  and:
    - file.inFolder("monsters")
    - file.name != "index"
formulas:
  Name: file.asLink(title)
properties:
  formula.Name:
    displayName: Name
  creature_type:
    displayName: Type
  size:
    displayName: Size
  cr:
    displayName: CR
  source:
    displayName: Source
views:
  - type: table
    name: All Monsters
    order: [formula.Name, creature_type, size, cr, source]
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Beasts
    filters:
      and:
        - creature_type == "Beast"
    order: [formula.Name, size, cr, source]
  - type: table
    name: Monstrosities
    filters:
      and:
        - creature_type == "Monstrosity"
    order: [formula.Name, size, cr, source]
  - type: table
    name: Undead
    filters:
      and:
        - creature_type == "Undead"
    order: [formula.Name, size, cr, source]
