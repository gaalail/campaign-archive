filters:
  and:
    - file.inFolder("character-options/class-options")
    - parent_class == "Warlock"
    - option_group == "Eldritch Invocation"
formulas:
  Name: file.asLink(title)
properties:
  formula.Name:
    displayName: Invocation
  min_level:
    displayName: Level
  prerequisite:
    displayName: Prerequisite
  summary:
    displayName: Summary
views:
  - type: table
    name: Eldritch Invocations
    groupBy:
      property: min_level
      direction: ASC
    order: [formula.Name, prerequisite, summary]
    sort:
      - property: min_level
        direction: ASC
      - property: file.name
        direction: ASC
