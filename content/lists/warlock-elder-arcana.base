filters:
  and:
    - file.inFolder("character-options/class-options/elder-arcana")
    - file.name != "index"
    - parent_class == "Warlock"
    - option_group == "Elder Arcanum"
formulas:
  Name: file.asLink(title)
properties:
  formula.Name:
    displayName: Elder Arcanum
  min_level:
    displayName: Level
  prerequisite:
    displayName: Prerequisite
  summary:
    displayName: Summary
views:
  - type: table
    name: Elder Arcana
    groupBy:
      property: min_level
      direction: ASC
    order: [formula.Name, prerequisite, summary]
    sort:
      - property: min_level
        direction: ASC
      - property: file.name
        direction: ASC
