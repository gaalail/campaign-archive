{
  "source_types": ["SRD", "official-supplement", "homebrew", "third-party", "campaign-original"],
  "content_status": ["complete", "incomplete", "draft"],
  "editions": ["2014", "2024", "system-neutral"],
  "adaptations": ["verbatim", "summarized", "curated", "adapted", "original"],
  "license_statuses": ["CC-BY-4.0", "reference-only", "original"],
  "rule_categories": [
    "condition",
    "combat",
    "adventuring",
    "spellcasting",
    "campaign_rule",
    "house_rule"
  ],
  "campaigns": ["curse-of-strahd", "ra-golvek", "vyrun"],
  "calendar_systems": ["gregorian", "custom", "campaign-defined"],
  "schemas": {
    "rule": {
      "required": ["title", "category"],
      "fields": {
        "entity_type": { "type": "string", "enum": ["rule"] },
        "canonical_id": { "type": "string", "non_empty": true },
        "category": { "type": "string", "enum_from": "rule_categories" },
        "campaign": {
          "type": "string",
          "enum_from": "campaigns",
          "required_when": { "field": "category", "equals": "campaign_rule" }
        },
        "title": { "type": "string", "non_empty": true },
        "summary": { "type": "string", "non_empty": true },
        "source": { "type": "string", "non_empty": true },
        "source_type": { "type": "string", "enum_from": "source_types" },
        "edition": { "type": "string", "enum_from": "editions" },
        "adaptation": { "type": "string", "enum_from": "adaptations" },
        "license_status": { "type": "string", "enum_from": "license_statuses" },
        "content_status": { "type": "string", "enum_from": "content_status" },
        "incomplete_reason": { "type": "string", "non_empty": true }
      }
    },
    "class": {
      "required": ["title", "hit_die", "saving_throws", "source"],
      "fields": {
        "entity_type": {
          "type": "string",
          "enum": ["class", "spell", "item", "campaign", "monster", "rule", "character_option"]
        },
        "canonical_id": { "type": "string", "non_empty": true },
        "edition": { "type": "string", "enum_from": "editions" },
        "adaptation": { "type": "string", "enum_from": "adaptations" },
        "license_status": { "type": "string", "enum_from": "license_statuses" },
        "hit_die": { "type": "string", "enum": ["d6", "d8", "d10", "d12"] },
        "saving_throws": {
          "type": "array",
          "min_items": 2,
          "max_items": 2,
          "items": { "type": "string", "enum": ["STR", "DEX", "CON", "INT", "WIS", "CHA"] }
        },
        "source": { "type": "string", "non_empty": true },
        "source_type": { "type": "string", "enum_from": "source_types" },
        "content_status": { "type": "string", "enum_from": "content_status" },
        "incomplete_reason": { "type": "string", "non_empty": true }
      }
    },
    "spell": {
      "required": ["title", "level", "school", "classes", "source"],
      "fields": {
        "entity_type": {
          "type": "string",
          "enum": ["class", "spell", "item", "campaign", "monster", "rule", "character_option"]
        },
        "canonical_id": { "type": "string", "non_empty": true },
        "edition": { "type": "string", "enum_from": "editions" },
        "adaptation": { "type": "string", "enum_from": "adaptations" },
        "license_status": { "type": "string", "enum_from": "license_statuses" },
        "title": { "type": "string", "non_empty": true },
        "level": { "type": "integer", "minimum": 0, "maximum": 9 },
        "school": { "type": "string", "non_empty": true },
        "classes": {
          "type": "array",
          "min_items": 1,
          "items": { "type": "string", "non_empty": true }
        },
        "source": { "type": "string", "non_empty": true },
        "source_type": { "type": "string", "enum_from": "source_types" },
        "content_status": { "type": "string", "enum_from": "content_status" },
        "incomplete_reason": { "type": "string", "non_empty": true }
      }
    },
    "item": {
      "required": ["title", "item_type", "rarity", "source"],
      "fields": {
        "entity_type": {
          "type": "string",
          "enum": ["class", "spell", "item", "campaign", "monster", "rule", "character_option"]
        },
        "canonical_id": { "type": "string", "non_empty": true },
        "edition": { "type": "string", "enum_from": "editions" },
        "adaptation": { "type": "string", "enum_from": "adaptations" },
        "license_status": { "type": "string", "enum_from": "license_statuses" },
        "title": { "type": "string", "non_empty": true },
        "item_type": { "type": "string", "non_empty": true },
        "rarity": { "type": "string", "non_empty": true },
        "source": { "type": "string", "non_empty": true },
        "source_type": { "type": "string", "enum_from": "source_types" },
        "content_status": { "type": "string", "enum_from": "content_status" },
        "incomplete_reason": { "type": "string", "non_empty": true }
      }
    },
    "campaign": {
      "required": [
        "title",
        "campaign_id",
        "calendar_id",
        "calendar_name",
        "calendar_system",
        "current_year",
        "current_month",
        "current_day"
      ],
      "fields": {
        "entity_type": {
          "type": "string",
          "enum": ["class", "spell", "item", "campaign", "monster", "rule", "character_option"]
        },
        "canonical_id": { "type": "string", "non_empty": true },
        "campaign_id": { "type": "string", "enum_from": "campaigns" },
        "calendar_id": { "type": "string", "non_empty": true },
        "calendar_name": { "type": "string", "non_empty": true },
        "calendar_system": { "type": "string", "enum_from": "calendar_systems" },
        "current_year": { "type": "integer" },
        "current_month": { "type": "integer", "minimum": 1 },
        "current_day": { "type": "integer", "minimum": 1 },
        "calendar_month_names": {
          "type": "array",
          "items": { "type": "string", "non_empty": true }
        },
        "calendar_days_per_month": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1, "maximum": 31 }
        },
        "calendar_weekday_names": {
          "type": "array",
          "items": { "type": "string", "non_empty": true }
        },
        "map_image": { "type": "string", "non_empty": true },
        "edition": { "type": "string", "enum_from": "editions" },
        "adaptation": { "type": "string", "enum_from": "adaptations" },
        "license_status": { "type": "string", "enum_from": "license_statuses" },
        "title": { "type": "string", "non_empty": true },
        "source": { "type": "string", "non_empty": true },
        "source_type": { "type": "string", "enum_from": "source_types" },
        "content_status": { "type": "string", "enum_from": "content_status" },
        "incomplete_reason": { "type": "string", "non_empty": true }
      }
    },
    "campaign_entry": {
      "required": ["title", "campaign_id", "type", "summary"],
      "fields": {
        "entity_type": { "type": "string", "enum": ["campaign_entry"] },
        "canonical_id": { "type": "string", "non_empty": true },
        "title": { "type": "string", "non_empty": true },
        "campaign_id": { "type": "string", "enum_from": "campaigns" },
        "type": {
          "type": "string",
          "enum": [
            "Character",
            "Place",
            "Faction",
            "Lore",
            "Session",
            "Item",
            "Rules",
            "Other",
            "Encounter",
            "CalendarEvent"
          ]
        },
        "summary": { "type": "string", "non_empty": true },
        "session_number": { "type": "integer", "minimum": 1 },
        "date": { "type": "string", "non_empty": true },
        "calendar_id": { "type": "string", "non_empty": true },
        "year": { "type": "integer" },
        "month": { "type": "integer", "minimum": 1 },
        "day": { "type": "integer", "minimum": 1 },
        "locations": { "type": "array", "items": { "type": "string", "non_empty": true } },
        "characters": { "type": "array", "items": { "type": "string", "non_empty": true } },
        "factions": { "type": "array", "items": { "type": "string", "non_empty": true } },
        "encounters": { "type": "array", "items": { "type": "string", "non_empty": true } },
        "appeared_in": { "type": "array", "items": { "type": "string", "non_empty": true } },
        "map_x": { "type": "integer", "minimum": 0, "maximum": 100 },
        "map_y": { "type": "integer", "minimum": 0, "maximum": 100 },
        "source_type": { "type": "string", "enum_from": "source_types" },
        "content_status": { "type": "string", "enum_from": "content_status" },
        "incomplete_reason": { "type": "string", "non_empty": true }
      }
    },
    "monster": {
      "required": ["title", "size", "creature_type", "alignment", "cr", "source"],
      "fields": {
        "entity_type": {
          "type": "string",
          "enum": ["class", "spell", "item", "campaign", "monster", "rule", "character_option"]
        },
        "canonical_id": { "type": "string", "non_empty": true },
        "edition": { "type": "string", "enum_from": "editions" },
        "adaptation": { "type": "string", "enum_from": "adaptations" },
        "license_status": { "type": "string", "enum_from": "license_statuses" },
        "title": { "type": "string", "non_empty": true },
        "size": { "type": "string", "non_empty": true },
        "creature_type": { "type": "string", "non_empty": true },
        "alignment": { "type": "string", "non_empty": true },
        "cr": { "type": "string", "non_empty": true },
        "habitats": {
          "type": "array",
          "items": { "type": "string", "non_empty": true }
        },
        "roles": {
          "type": "array",
          "items": { "type": "string", "non_empty": true }
        },
        "tags": {
          "type": "array",
          "items": { "type": "string", "non_empty": true }
        },
        "legendary": { "type": "boolean" },
        "lair": { "type": "boolean" },
        "spellcaster": { "type": "boolean" },
        "campaigns": {
          "type": "array",
          "items": { "type": "string", "non_empty": true }
        },
        "encounters": {
          "type": "array",
          "items": { "type": "string", "non_empty": true }
        },
        "source_type": { "type": "string", "enum_from": "source_types" },
        "content_status": { "type": "string", "enum_from": "content_status" },
        "incomplete_reason": { "type": "string", "non_empty": true }
      }
    },
    "character_option": {
      "required": ["title"],
      "fields": {
        "entity_type": {
          "type": "string",
          "enum": ["class", "spell", "item", "campaign", "monster", "rule", "character_option"]
        },
        "canonical_id": { "type": "string", "non_empty": true },
        "edition": { "type": "string", "enum_from": "editions" },
        "adaptation": { "type": "string", "enum_from": "adaptations" },
        "license_status": { "type": "string", "enum_from": "license_statuses" },
        "title": { "type": "string", "non_empty": true },
        "source": { "type": "string", "non_empty": true },
        "source_type": { "type": "string", "enum_from": "source_types" },
        "content_status": { "type": "string", "enum_from": "content_status" },
        "incomplete_reason": { "type": "string", "non_empty": true }
      }
    }
  }
}
